# Database
DATABASE_URL=postgresql+asyncpg://ragkb:ragkb_dev@postgres:5432/ragkb
DATABASE_URL_SYNC=postgresql+psycopg2://ragkb:ragkb_dev@postgres:5432/ragkb
POSTGRES_DB=ragkb
POSTGRES_USER=ragkb
POSTGRES_PASSWORD=ragkb_dev

# Redis
REDIS_URL=redis://redis:6379/0

# Embedding
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Chunking
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# Hybrid retrieval
DENSE_TOP_K=20
SPARSE_TOP_K=20
FINAL_TOP_K=8
CANDIDATE_POOL=30
NEIGHBOR_WINDOW=1
RRF_K=60
RETRIEVAL_THRESHOLD=0.18
DENSE_MIN_SCORE=0.22
DUAL_QUERY_RETRIEVE=true
REWRITE_ENABLED=true

# LLM
# One model id for the active provider. Groq speaks the OpenAI API.
# The extra openai/ prefix is required so the request model is openai/gpt-oss-120b.
LLM_PROVIDER=openai
LLM_MODEL=openai/openai/gpt-oss-120b
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.groq.com/openai/v1

# NVIDIA Build. To switch back, set LLM_PROVIDER=nvidia and
# LLM_MODEL=nvidia_nim/nvidia/nemotron-3.5-bolt-e4b
NVIDIA_API_KEY=nvapi-your-key-here
NVIDIA_API_BASE=https://integrate.api.nvidia.com/v1
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_API_BASE=http://ollama:11434

# Upload
UPLOAD_DIR=/app/uploads
UPLOAD_MAX_MB=20

# Rate Limiting
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW=60

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
